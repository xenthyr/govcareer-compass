# ============================================================================
# GovCareer Compass — Vercel / CompassAI configuration
# ============================================================================
#
# IMPORTANT:
# Never put real credentials in this file.
# Never commit a real .env file.
#
# Configure actual values in:
#
# Vercel Dashboard
# → Your Project
# → Settings
# → Environment Variables
# ============================================================================

# OpenRouter secret API key.
OPENROUTER_API_KEY=

# OpenRouter model slug.
#
# Example format:
# provider/model
#
# Choose the model from the current OpenRouter model catalogue.
OPENROUTER_MODEL=

# Your production website URL.
#
# Example:
# https://your-project.vercel.app
#
PUBLIC_SITE_URL=

# Optional additional trusted origins.
#
# Example:
# https://your-project.vercel.app,https://www.yourdomain.com
#
ALLOWED_ORIGINS=

# ---------------------------------------------------------------------------
# CompassAI request limits
# ---------------------------------------------------------------------------

AI_MAX_MESSAGES=12

AI_MAX_MESSAGE_CHARS=6000

AI_MAX_CONTEXT_CHARS=30000

AI_MAX_OUTPUT_TOKENS=1200

AI_REQUEST_TIMEOUT_MS=45000

AI_MAX_REQUEST_BYTES=100000

AI_MIN_USER_MESSAGE_CHARS=1
