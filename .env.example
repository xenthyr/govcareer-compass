# ============================================================================
# GovCareer Compass — Environment Variable Template
# ============================================================================
#
# IMPORTANT:
# This file contains variable NAMES only.
# Never put a real API key in this file.
#
# Configure the real values in:
# Vercel Dashboard
# → Project
# → Settings
# → Environment Variables
# ============================================================================

OPENAI_API_KEY=

# Model used by CompassAI.
# Keep this configurable so the model can be changed without modifying code.
OPENAI_MODEL=

# Optional public-origin restriction.
#
# Example:
# https://your-production-domain.vercel.app
#
# Multiple origins may be comma-separated when necessary.
#
# Leave empty during initial development if same-origin validation is sufficient.
ALLOWED_ORIGINS=

# Maximum number of user messages retained by the server for one request.
AI_MAX_MESSAGES=12

# Maximum characters accepted for one user message.
AI_MAX_MESSAGE_CHARS=6000

# Maximum characters accepted for the optional structured GovCareer Compass context.
AI_MAX_CONTEXT_CHARS=30000

# Maximum generated output tokens requested from the model.
AI_MAX_OUTPUT_TOKENS=1200
