    },
    {
      "id": "eligibility-kp-si-physical",
      "name": {
        "en": "Kolkata Police Sub-Inspector physical and medical requirement",
        "bn": "কলকাতা পুলিশ সাব-ইন্সপেক্টর শারীরিক ও চিকিৎসাগত যোগ্যতা"
      },
      "ruleType": "PHYSICAL_REQUIREMENT",
      "logic": "ALL",
      "priority": "MANDATORY",
      "operator": "HAS",
      "subject": {
        "field": "physicalAndMedicalProfile",
        "profileFieldId": "candidate.physicalAndMedicalProfile"
      },
      "physical": {
        "required": true,
        "profileId": "physical-kp-si"
      },
      "medical": {
        "required": true,
        "standardId": "medical-kp-si"
      },
      "failureStatus": "NOT_ELIGIBLE",
      "unknownStatus": "REQUIRES_MANUAL_VERIFICATION",
      "sourceIds": [
        "src-wbprb-kp-si-2023"
      ],
      "status": "ACTIVE",
      "version": "1.0.0",
      "notes": {
        "en": "Exact current measurements and endurance conditions must be linked to the applicable recruitment notice rather than inferred from another police recruitment cycle.",
        "bn": "সঠিক বর্তমান শারীরিক মাপ ও সহনশীলতার শর্ত প্রযোজ্য নিয়োগ বিজ্ঞপ্তির সঙ্গে লিঙ্ক করতে হবে; অন্য পুলিশ নিয়োগ চক্র থেকে অনুমান করা যাবে না।"
      }
    }
  ]
