      "sourceIds": [
        "src-wbprb-wbp-si-2024"
      ],
      "status": "ACTIVE",
      "version": "1.0.0"
    },
    {
      "id": "eligibility-wbp-si-physical",
      "name": {
        "en": "West Bengal Police Sub-Inspector physical and medical requirement",
        "bn": "পশ্চিমবঙ্গ পুলিশ সাব-ইন্সপেক্টর শারীরিক ও চিকিৎসাগত যোগ্যতা"
      },
      "ruleType": "PHYSICAL_REQUIREMENT",
      "logic": "ALL",
      "priority": "MANDATORY",
      "operator": "HAS",
      "subject": {
        "field": "physicalAndMedicalProfile",
        "profileFieldId": "candidate.physicalAndMedicalProfile"
      },
      "physical": {
        "required": true,
