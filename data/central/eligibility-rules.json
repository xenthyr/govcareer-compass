    {
      "id": "eligibility-cse-general-degree",
      "name": {
        "en": "Civil Services general degree requirement",
        "bn": "সিভিল সার্ভিসেস সাধারণ ডিগ্রি যোগ্যতা"
      },
      "description": {
        "en": "Recognised bachelor's degree or equivalent as prescribed by the applicable Civil Services Examination notification.",
        "bn": "প্রযোজ্য সিভিল সার্ভিসেস পরীক্ষার বিজ্ঞপ্তিতে নির্ধারিত স্বীকৃত স্নাতক ডিগ্রি বা সমমানের যোগ্যতা।"
      },
      "ruleType": "HARD_ELIGIBILITY",
      "logic": "ALL",
      "priority": "MANDATORY",
      "operator": "HAS",
      "subject": {
        "field": "qualifications",
        "profileFieldId": "candidate.qualifications"
      },
      "requiredQualifications": [
        "qualification-bachelor-any-discipline"
      ],
      "failureStatus": "NOT_ELIGIBLE",
      "unknownStatus": "REQUIRES_MANUAL_VERIFICATION",
      "explanation": {
        "en": "The candidate must possess the prescribed bachelor's degree or equivalent by the applicable cutoff date.",
        "bn": "প্রযোজ্য কাট-অফ তারিখের মধ্যে প্রয়োজনীয় স্নাতক ডিগ্রি বা সমমানের যোগ্যতা থাকতে হবে।"
      },
      "sourceIds": [
        "src-upsc-cse-2026"
      ],
      "sourceDate": "2026-02-04",
      "status": "ACTIVE",
      "version": "1.0.0"
    },
