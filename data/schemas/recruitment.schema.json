{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "recruitment.schema.json",
  "title": "GovCareer Compass Recruitment",
  "description": "A recruitment event or recruitment route connecting an authority/examination with one or more posts.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "authorityId",
    "postIds",
    "mode",
    "status",
    "currentness",
    "sourceIds",
    "confidence",
    "lastVerified",
    "dataVersion"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]*$"
    },
    "authorityId": {
      "type": "string",
      "minLength": 1
    },
    "examId": {
      "type": "string"
    },
    "postIds": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "mode": {
      "type": "string",
      "enum": [
        "DIRECT_RECRUITMENT",
        "PROMOTION",
        "DEPUTATION",
        "TRANSFER",
        "CONTRACT",
        "TEMPORARY",
        "SCHEME_PROJECT",
        "OUTSOURCED",
        "OTHER"
      ]
    },
    "status": {
      "type": "string",
      "enum": [
        "OPEN",
        "CLOSED",
        "UNDER_PROCESS",
        "RECENTLY_COMPLETED",
        "EXPECTED_PERIODIC",
        "IRREGULAR",
        "HISTORICAL",
        "CANCELLED",
        "NOT_VERIFIED"
      ]
    },
    "notificationDate": {
      "type": "string",
      "format": "date"
    },
    "applicationStartDate": {
      "type": "string",
      "format": "date"
    },
    "applicationEndDate": {
      "type": "string",
      "format": "date"
    },
    "examDate": {
      "type": "string",
      "format": "date"
    },
    "resultDate": {
      "type": "string",
      "format": "date"
    },
    "vacancy": {
      "type": [
        "integer",
        "string"
      ],
      "minimum": 0
    },
    "vacancyBreakdown": {
      "type": "object",
      "additionalProperties": {
        "type": [
          "integer",
          "string"
        ]
      }
    },
    "applicationUrl": {
      "type": "string",
      "format": "uri"
    },
    "notificationUrl": {
      "type": "string",
      "format": "uri"
    },
    "sourceIds": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "currentness": {
      "type": "string",
      "enum": [
        "CURRENT",
        "HISTORICAL",
        "CURRENT_WITH_HISTORICAL_SUPPORT",
        "REPLACED",
        "ABOLISHED",
        "NOT_VERIFIED"
      ]
    },
    "confidence": {
      "type": "string",
      "enum": [
        "HIGH",
        "MEDIUM_HIGH",
        "MEDIUM",
        "LOW",
        "ESTIMATE",
        "NOT_VERIFIED"
      ]
    },
    "notes": {
      "type": "string"
    },
    "lastVerified": {
      "type": "string",
      "format": "date"
    },
    "dataVersion": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    }
  }
}
