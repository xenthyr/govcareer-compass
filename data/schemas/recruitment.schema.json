{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "recruitment.schema.json",
  "title": "GovCareer Compass Recruitment",
  "description": "Individual recruitment event or recruitment route.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "authorityId",
    "postIds",
    "mode",
    "status",
    "currentness",
    "sourceIds",
    "confidence",
    "lastVerified",
    "dataVersion"
  ],
  "properties": {
    "id": {
      "$ref": "shared.schema.json#/$defs/id"
    },
    "authorityId": {
      "$ref": "shared.schema.json#/$defs/id"
    },
    "examId": {
      "$ref": "shared.schema.json#/$defs/id"
    },
    "postIds": {
      "$ref": "shared.schema.json#/$defs/stringArray"
    },
    "mode": {
      "type": "string",
      "enum": [
        "DIRECT_RECRUITMENT",
        "PROMOTION",
        "DEPUTATION",
        "TRANSFER",
        "CONTRACT",
        "TEMPORARY",
        "SCHEME_PROJECT",
        "OUTSOURCED",
        "OTHER"
      ]
    },
    "status": {
      "type": "string",
      "enum": [
        "OPEN",
        "CLOSED",
        "UNDER_PROCESS",
        "RECENTLY_COMPLETED",
        "EXPECTED_PERIODIC",
        "IRREGULAR",
        "HISTORICAL",
        "CANCELLED",
        "NOT_VERIFIED"
      ]
    },
    "notificationDate": {
      "$ref": "shared.schema.json#/$defs/date"
    },
    "applicationStartDate": {
      "$ref": "shared.schema.json#/$defs/date"
    },
    "applicationEndDate": {
      "$ref": "shared.schema.json#/$defs/date"
    },
    "examDate": {
      "$ref": "shared.schema.json#/$defs/date"
    },
    "resultDate": {
      "$ref": "shared.schema.json#/$defs/date"
    },
    "vacancy": {
      "type": [
        "integer",
        "string"
      ],
      "minimum": 0
    },
    "vacancyBreakdown": {
      "type": "object",
      "additionalProperties": {
        "type": [
          "integer",
          "string"
        ]
      }
    },
    "applicationUrl": {
      "$ref": "shared.schema.json#/$defs/url"
    },
    "notificationUrl": {
      "$ref": "shared.schema.json#/$defs/url"
    },
    "sourceIds": {
      "$ref": "shared.schema.json#/$defs/stringArray"
    },
    "currentness": {
      "$ref": "shared.schema.json#/$defs/currentness"
    },
    "confidence": {
      "$ref": "shared.schema.json#/$defs/confidence"
    },
    "notes": {
      "type": "string"
    },
    "lastVerified": {
      "$ref": "shared.schema.json#/$defs/date"
    },
    "dataVersion": {
      "$ref": "shared.schema.json#/$defs/version"
    }
  }
}
