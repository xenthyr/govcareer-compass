{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "state.schema.json",
  "title": "GovCareer Compass State",
  "description": "Indian State or Union Territory coverage record.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "name",
    "type",
    "enabled",
    "coverage",
    "lastVerified",
    "dataVersion"
  ],
  "properties": {
    "id": {
      "$ref": "shared.schema.json#/$defs/id"
    },
    "name": {
      "$ref": "shared.schema.json#/$defs/localizedText"
    },
    "type": {
      "type": "string",
      "enum": [
        "STATE",
        "UNION_TERRITORY"
      ]
    },
    "capital": {
      "$ref": "shared.schema.json#/$defs/localizedText"
    },
    "enabled": {
      "type": "boolean"
    },
    "coverage": {
      "type": "string",
      "enum": [
        "ACTIVE",
        "PLANNED",
        "RESEARCHING",
        "PARTIAL",
        "TEMPORARILY_DISABLED"
      ]
    },
    "governmentId": {
      "$ref": "shared.schema.json#/$defs/id"
    },
    "website": {
      "$ref": "shared.schema.json#/$defs/url"
    },
    "sourceIds": {
      "$ref": "shared.schema.json#/$defs/stringArray"
    },
    "lastVerified": {
      "$ref": "shared.schema.json#/$defs/date"
    },
    "dataVersion": {
      "$ref": "shared.schema.json#/$defs/version"
    }
  }
}
