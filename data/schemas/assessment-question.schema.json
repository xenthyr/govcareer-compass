{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://govcareer-compass.github.io/schemas/assessment-question.schema.json",
  "title": "GovCareer Compass Assessment Question Catalogue",
  "description": "Canonical JSON Schema for the complete GovCareer Compass Career Finder question catalogue. The catalogue defines questions and their references to reusable option sets and normalized candidate-profile fields. It does not contain government-job eligibility rules or recommendation logic.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "lastUpdated",
    "assessmentId",
    "assessmentVersion",
    "defaultLanguage",
    "supportedLanguages",
    "questionOrder",
    "questions"
  ],
  "properties": {
    "version": {
      "$ref": "shared.schema.json#/$defs/version"
    },
    "lastUpdated": {
      "$ref": "shared.schema.json#/$defs/date"
    },
    "assessmentId": {
      "$ref": "shared.schema.json#/$defs/id"
    },
    "assessmentVersion": {
      "$ref": "shared.schema.json#/$defs/version"
    },
    "defaultLanguage": {
      "$ref": "shared.schema.json#/$defs/languageCode"
    },
    "supportedLanguages": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "shared.schema.json#/$defs/languageCode"
      }
    },
    "schema": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string"
    },
    "designPrinciples": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "questionOrder": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "shared.schema.json#/$defs/id"
      }
    },
    "questions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/question"
      }
    }
  },
  "$defs": {
    "localizedText": {
      "$ref": "shared.schema.json#/$defs/localizedText"
    },

    "question": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "type",
        "question",
        "required",
        "profileField",
        "status"
      ],
      "properties": {
        "id": {
          "$ref": "shared.schema.json#/$defs/id"
        },

        "type": {
          "type": "string",
          "enum": [
            "SINGLE_SELECT",
            "MULTI_SELECT",
            "BOOLEAN",
            "SCALE",
            "NUMBER",
            "TEXT"
          ]
        },

        "question": {
          "$ref": "#/$defs/localizedText"
        },

        "helpText": {
          "$ref": "#/$defs/localizedText"
        },

        "profileField": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9_.-]+$",
          "minLength": 1
        },

        "required": {
          "type": "boolean"
        },

        "optionSetId": {
          "$ref": "shared.schema.json#/$defs/id"
        },

        "scale": {
          "$ref": "#/$defs/scale"
        },

        "validation": {
          "$ref": "#/$defs/validation"
        },

        "sensitive": {
          "type": "boolean"
        },

        "allowPreferNotToSay": {
          "type": "boolean"
        },

        "status": {
          "type": "string",
          "enum": [
            "ACTIVE",
            "DRAFT",
            "DEPRECATED"
          ]
        }
      },

      "allOf": [
        {
          "if": {
            "properties": {
              "type": {
                "enum": [
                  "SINGLE_SELECT",
                  "MULTI_SELECT"
                ]
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "required": [
              "optionSetId"
            ]
          }
        },

        {
          "if": {
            "properties": {
              "type": {
                "const": "SCALE"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "required": [
              "scale"
            ]
          }
        },

        {
          "if": {
            "properties": {
              "sensitive": {
                "const": true
              }
            },
            "required": [
              "sensitive"
            ]
          },
          "then": {
            "properties": {
              "required": {
                "const": false
              }
            }
          }
        }
      ]
    },

    "scale": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "min",
        "max",
        "step"
      ],
      "properties": {
        "min": {
          "type": "number"
        },
        "max": {
          "type": "number"
        },
        "step": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "minLabel": {
          "$ref": "#/$defs/localizedText"
        },
        "maxLabel": {
          "$ref": "#/$defs/localizedText"
        }
      }
    },

    "validation": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "minLength": {
          "type": "integer",
          "minimum": 0
        },
        "maxLength": {
          "type": "integer",
          "minimum": 0
        },
        "minimum": {
          "type": "number"
        },
        "maximum": {
          "type": "number"
        },
        "pattern": {
          "type": "string"
        }
      }
    }
  }
}
