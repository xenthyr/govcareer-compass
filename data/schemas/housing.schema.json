{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "housing.schema.json",
  "title": "GovCareer Compass Housing Profile",
  "description": "Government accommodation and private-housing impact profile.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "availabilityStatus",
    "confidence",
    "lastVerified",
    "dataVersion"
  ],
  "properties": {
    "id": {
      "$ref": "shared.schema.json#/$defs/id"
    },
    "accommodationTypes": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "GOVERNMENT_QUARTER",
          "DEPARTMENTAL_QUARTER",
          "POLICE_HOUSING",
          "RAILWAY_QUARTER",
          "BARRACK",
          "HOSTEL",
          "OTHER",
          "NONE"
        ]
      },
      "uniqueItems": true
    },
    "entitlement": {
      "type": "string"
    },
    "eligibility": {
      "type": "string"
    },
    "availabilityStatus": {
      "type": "string",
      "enum": [
        "MEANINGFUL_ADVANTAGE",
        "VACANCY_DEPENDENT",
        "DEPARTMENTAL",
        "LIMITED",
        "NONE_IDENTIFIED",
        "NOT_VERIFIED"
      ]
    },
    "allotment": {
      "type": "object"
    },
    "waitingList": {
      "type": "object"
    },
    "licenceFee": {
      "type": "object"
    },
    "hraEffect": {
      "type": "object"
    },
    "utilityCosts": {
      "type": "object"
    },
    "maintenanceCosts": {
      "type": "object"
    },
    "privateHousingAlternative": {
      "type": "object"
    },
    "practicalLikelihood": {
      "type": "string"
    },
    "housingAdvantageScore": {
      "$ref": "shared.schema.json#/$defs/score"
    },
    "notes": {
      "type": "string"
    },
    "sourceIds": {
      "$ref": "shared.schema.json#/$defs/stringArray"
    },
    "confidence": {
      "$ref": "shared.schema.json#/$defs/confidence"
    },
    "lastVerified": {
      "$ref": "shared.schema.json#/$defs/date"
    },
    "dataVersion": {
      "$ref": "shared.schema.json#/$defs/version"
    }
  }
}
