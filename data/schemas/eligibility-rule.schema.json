{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://govcareer-compass.example/schema/eligibility-rule.schema.json",
  "title": "GovCareer Compass Eligibility Rule",
  "description": "Canonical rule schema for determining whether a candidate is legally or procedurally eligible for a government job or examination. Hard eligibility rules are separate from soft preference scoring.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "name",
    "targetType",
    "targetId",
    "ruleClass",
    "conditionType",
    "operator",
    "status",
    "version"
  ],
  "properties": {
    "id": {
      "$ref": "shared.schema.json#/$defs/id"
    },

    "name": {
      "$ref": "shared.schema.json#/$defs/localizedTextRequiredEnglish"
    },

    "description": {
      "$ref": "shared.schema.json#/$defs/localizedText"
    },

    "targetType": {
      "type": "string",
      "enum": [
        "JOB",
        "EXAM",
        "SERVICE_CADRE",
        "RECRUITMENT"
      ]
    },

    "targetId": {
      "$ref": "shared.schema.json#/$defs/id"
    },

    "ruleClass": {
      "$ref": "shared.schema.json#/$defs/hardSoftClassification"
    },

    "conditionType": {
      "type": "string",
      "enum": [
        "EDUCATION_LEVEL",
        "QUALIFICATION",
        "DEGREE",
        "SUBJECT",
        "MARKS",
        "LANGUAGE",
        "MATHEMATICS",
        "STATISTICS",
        "ECONOMICS",
        "COMMERCE",
        "SCIENCE",
        "PROFESSIONAL_QUALIFICATION",
        "BED",
        "DELED",
        "BELED",
        "ITI",
        "DIPLOMA",
        "TET",
        "COMPUTER_KNOWLEDGE",
        "TYPING",
        "SHORTHAND",
        "DRIVING_LICENCE",
        "EXPERIENCE",
        "AGE",
        "CITIZENSHIP",
        "DOMICILE",
        "RESERVATION",
        "GENDER",
        "PHYSICAL_STANDARD",
        "PHYSICAL_EFFICIENCY_TEST",
        "MEDICAL_STANDARD",
        "EYESIGHT",
        "HEIGHT",
        "CHEST",
        "RUNNING",
        "WALKING",
        "CYCLING",
        "FITNESS",
        "OTHER"
      ]
    },

    "operator": {
      "type": "string",
      "enum": [
        "EQ",
        "NEQ",
        "GT",
        "GTE",
        "LT",
        "LTE",
        "IN",
        "NOT_IN",
        "HAS",
        "NOT_HAS",
        "ALL_OF",
        "ANY_OF",
        "NONE_OF"
      ]
    },

    "value": {},

    "qualificationIds": {
      "$ref": "shared.schema.json#/$defs/idArray"
    },

    "subjectIds": {
      "$ref": "shared.schema.json#/$defs/idArray"
    },

    "requiredQualificationIds": {
      "$ref": "shared.schema.json#/$defs/idArray"
    },

    "requiredSubjectIds": {
      "$ref": "shared.schema.json#/$defs/idArray"
    },

    "minimumMarks": {
      "type": "number",
      "minimum": 0
    },

    "minimumPercentage": {
      "type": "number",
      "minimum": 0,
      "maximum": 100
    },

    "minimumAge": {
      "type": "integer",
      "minimum": 0
    },

    "maximumAge": {
      "type": "integer",
      "minimum": 0
    },

    "requiredLanguages": {
      "$ref": "shared.schema.json#/$defs/nonEmptyStringArray"
    },

    "requiredSkills": {
      "$ref": "shared.schema.json#/$defs/nonEmptyStringArray"
    },

    "requiredExperience": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "minimumYears": {
          "type": "number",
          "minimum": 0
        },
        "experienceType": {
          "type": "string",
          "minLength": 1
        }
      }
    },

    "physicalStandard": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "gender": {
          "type": "string",
          "enum": [
            "ANY",
            "MALE",
            "FEMALE",
            "OTHER"
          ]
        },
        "minimumHeightCm": {
          "type": "number",
          "minimum": 0
        },
        "minimumChestCm": {
          "type": "number",
          "minimum": 0
        },
        "minimumExpandedChestCm": {
          "type": "number",
          "minimum": 0
        },
        "runningDistanceMeters": {
          "type": "number",
          "minimum": 0
        },
        "runningTimeSeconds": {
          "type": "number",
          "minimum": 0
        },
        "walkingDistanceMeters": {
          "type": "number",
          "minimum": 0
        },
        "walkingTimeSeconds": {
          "type": "number",
          "minimum": 0
        },
        "cyclingDistanceMeters": {
          "type": "number",
          "minimum": 0
        },
        "cyclingTimeSeconds": {
          "type": "number",
          "minimum": 0
        }
      }
    },

    "medicalStandard": {
      "type": "object",
      "additionalProperties": true
    },

    "exceptions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "condition"
        ],
        "properties": {
          "condition": {
            "type": "string",
            "minLength": 1
          },
          "effect": {
            "type": "string",
            "enum": [
              "ALLOW",
              "DISALLOW",
              "MODIFY",
              "REQUIRES_VERIFICATION"
            ]
          },
          "value": {}
        }
      }
    },

    "dependsOnRuleIds": {
      "$ref": "shared.schema.json#/$defs/idArray"
    },

    "sourceIds": {
      "$ref": "shared.schema.json#/$defs/idArray"
    },

    "sourceReferences": {
      "$ref": "shared.schema.json#/$defs/sourceReferenceArray"
    },

    "status": {
      "type": "string",
      "enum": [
        "ACTIVE",
        "DRAFT",
        "DEPRECATED",
        "HISTORICAL",
        "SUPERSEDED",
        "UNKNOWN"
      ]
    },

    "effectiveFrom": {
      "$ref": "shared.schema.json#/$defs/date"
    },

    "effectiveTo": {
      "$ref": "shared.schema.json#/$defs/date"
    },

    "priority": {
      "type": "integer",
      "minimum": 0
    },

    "notes": {
      "$ref": "shared.schema.json#/$defs/localizedText"
    },

    "confidence": {
      "$ref": "shared.schema.json#/$defs/confidence"
    },

    "version": {
      "$ref": "shared.schema.json#/$defs/version"
    }
  },

  "allOf": [
    {
      "if": {
        "properties": {
          "ruleClass": {
            "const": "HARD"
          }
        }
      },
      "then": {
        "required": [
          "sourceIds"
        ]
      }
    },

    {
      "if": {
        "properties": {
          "conditionType": {
            "const": "QUALIFICATION"
          }
        }
      },
      "then": {
        "required": [
          "qualificationIds"
        ]
      }
    },

    {
      "if": {
        "properties": {
          "conditionType": {
            "const": "SUBJECT"
          }
        }
      },
      "then": {
        "required": [
          "subjectIds"
        ]
      }
    },

    {
      "if": {
        "properties": {
          "conditionType": {
            "const": "AGE"
          }
        }
      },
      "then": {
        "anyOf": [
          {
            "required": [
              "minimumAge"
            ]
          },
          {
            "required": [
              "maximumAge"
            ]
          }
        ]
      }
    },

    {
      "if": {
        "properties": {
          "conditionType": {
            "const": "LANGUAGE"
          }
        }
      },
      "then": {
        "required": [
          "requiredLanguages"
        ]
      },

    {
      "if": {
        "properties": {
          "conditionType": {
            "const": "PHYSICAL_STANDARD"
          }
        }
      },
      "then": {
        "required": [
          "physicalStandard"
        ]
      }
    },

    {
      "if": {
        "properties": {
          "conditionType": {
            "const": "MEDICAL_STANDARD"
          }
        }
      },
      "then": {
        "required": [
          "medicalStandard"
        ]
      }
    }
  ]
}
