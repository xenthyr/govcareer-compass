{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "eligibility-rule.schema.json",
  "title": "GovCareer Compass Eligibility Rule",
  "description": "Structured eligibility requirement supporting alternative qualification pathways and additional conditions.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "ruleType",
    "requirements",
    "dataVersion"
  ],
  "properties": {
    "id": {
      "$ref": "shared.schema.json#/$defs/id"
    },
    "ruleType": {
      "type": "string",
      "enum": [
        "ALL",
        "ANY",
        "AT_LEAST_ONE"
      ]
    },
    "requirements": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "requirementType"
        ],
        "properties": {
          "requirementType": {
            "type": "string",
            "enum": [
              "QUALIFICATION",
              "EDUCATION_LEVEL",
              "SUBJECT",
              "MARKS",
              "LANGUAGE",
              "TYPING",
              "SHORTHAND",
              "COMPUTER",
              "DRIVING_LICENCE",
              "REGISTRATION",
              "EXPERIENCE",
              "PHYSICAL_STANDARD",
              "MEDICAL_STANDARD",
              "AGE",
              "DOMICILE",
              "GENDER",
              "CITIZENSHIP",
              "OTHER"
            ]
          },
          "qualificationIds": {
            "$ref": "shared.schema.json#/$defs/stringArray"
          },
          "educationLevel": {
            "type": "string"
          },
          "subjectIds": {
            "$ref": "shared.schema.json#/$defs/stringArray"
          },
          "minimumMarks": {
            "type": "number",
            "minimum": 0
          },
          "percentageType": {
            "type": "string",
            "enum": [
              "AGGREGATE",
              "SUBJECT",
              "QUALIFYING_EXAM",
              "DEGREE",
              "OTHER"
            ]
          },
          "languageIds": {
            "$ref": "shared.schema.json#/$defs/stringArray"
          },
          "typingRequirement": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "language": {
                "type": "string"
              },
              "minimumSpeed": {
                "type": "number",
                "minimum": 0
              },
              "unit": {
                "type": "string"
              }
            }
          },
          "shorthandRequirement": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "minimumSpeed": {
                "type": "number",
                "minimum": 0
              },
              "unit": {
                "type": "string"
              }
            }
          },
          "computerRequirement": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "knowledgeRequired": {
                "type": "boolean"
              },
              "qualificationIds": {
                "$ref": "shared.schema.json#/$defs/stringArray"
              }
            }
          },
          "registrationRequirement": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "authority": {
                "type": "string"
              },
              "registrationType": {
                "type": "string"
              }
            }
          },
          "experienceRequirement": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "minimumYears": {
                "type": "number",
                "minimum": 0
              },
              "description": {
                "type": "string"
              }
            }
          },
          "ageRequirement": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "minimum": {
                "type": "number",
                "minimum": 0
              },
              "maximum": {
                "type": "number",
                "minimum": 0
              },
              "cutOffDescription": {
                "type": "string"
              }
            }
          },
          "domicileRequirement": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "required": {
                "type": "boolean"
              },
              "stateIds": {
                "$ref": "shared.schema.json#/$defs/stringArray"
              }
            }
          },
          "genderRequirement": {
            "type": "string"
          },
          "physicalStandardRequirement": {
            "type": "object"
          },
          "medicalRequirement": {
            "type": "object"
          },
          "description": {
            "type": "string"
          }
        }
      }
    },
    "sourceIds": {
      "$ref": "shared.schema.json#/$defs/stringArray"
    },
    "confidence": {
      "$ref": "shared.schema.json#/$defs/confidence"
    },
    "dataVersion": {
      "$ref": "shared.schema.json#/$defs/version"
    }
  }
}
