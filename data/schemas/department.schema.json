{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "department.schema.json",
  "title": "GovCareer Compass Department",
  "description": "Government department, ministry, secretariat or equivalent administrative unit.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "governmentId",
    "name",
    "type",
    "status",
    "confidence",
    "lastVerified",
    "dataVersion"
  ],
  "properties": {
    "id": {
      "$ref": "shared.schema.json#/$defs/id"
    },
    "governmentId": {
      "$ref": "shared.schema.json#/$defs/id"
    },
    "stateId": {
      "$ref": "shared.schema.json#/$defs/id"
    },
    "name": {
      "$ref": "shared.schema.json#/$defs/localizedText"
    },
    "shortName": {
      "type": "string"
    },
    "type": {
      "type": "string",
      "enum": [
        "MINISTRY",
        "DEPARTMENT",
        "SECRETARIAT",
        "DIRECTORATE",
        "ATTACHED_DEPARTMENT",
        "SUBORDINATE_DEPARTMENT",
        "OTHER"
      ]
    },
    "description": {
      "$ref": "shared.schema.json#/$defs/localizedText"
    },
    "website": {
      "$ref": "shared.schema.json#/$defs/url"
    },
    "directorateIds": {
      "$ref": "shared.schema.json#/$defs/stringArray"
    },
    "organisationIds": {
      "$ref": "shared.schema.json#/$defs/stringArray"
    },
    "serviceCadreIds": {
      "$ref": "shared.schema.json#/$defs/stringArray"
    },
    "sourceIds": {
      "$ref": "shared.schema.json#/$defs/stringArray"
    },
    "status": {
      "type": "string",
      "enum": [
        "ACTIVE",
        "HISTORICAL",
        "REPLACED",
        "ABOLISHED",
        "NOT_VERIFIED"
      ]
    },
    "confidence": {
      "$ref": "shared.schema.json#/$defs/confidence"
    },
    "lastVerified": {
      "$ref": "shared.schema.json#/$defs/date"
    },
    "dataVersion": {
      "$ref": "shared.schema.json#/$defs/version"
    }
  }
}
