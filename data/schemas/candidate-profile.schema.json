{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "candidate-profile.schema.json",
  "title": "GovCareer Compass Candidate Profile",
  "description": "Normalized candidate profile used by eligibility and recommendation engines.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "profileVersion",
    "educationLevel",
    "qualifications",
    "preferences"
  ],
  "properties": {
    "profileVersion": {
      "$ref": "shared.schema.json#/$defs/version"
    },

    "educationLevel": {
      "type": "string",
      "enum": [
        "CLASS_8",
        "CLASS_10",
        "CLASS_12",
        "DIPLOMA",
        "ITI",
        "GRADUATE",
        "POSTGRADUATE",
        "DOCTORATE",
        "PROFESSIONAL",
        "OTHER"
      ]
    },

    "qualifications": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "qualificationId",
          "status"
        ],
        "properties": {
          "qualificationId": {
            "$ref": "shared.schema.json#/$defs/id"
          },
          "status": {
            "type": "string",
            "enum": [
              "COMPLETED",
              "FINAL_YEAR",
              "PURSUING"
            ]
          },
          "subjectIds": {
            "$ref": "shared.schema.json#/$defs/stringArray"
          },
          "tradeId": {
            "$ref": "shared.schema.json#/$defs/id"
          },
          "specialisation": {
            "type": "string"
          },
          "institution": {
            "type": "string"
          },
          "yearCompleted": {
            "type": "integer",
            "minimum": 1900
          }
        }
      }
    },

    "languages": {
      "$ref": "shared.schema.json#/$defs/stringArray"
    },

    "skills": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "typing": {
          "type": "boolean"
        },
        "shorthand": {
          "type": "boolean"
        },
        "computerKnowledge": {
          "type": "boolean"
        },
        "drivingLicence": {
          "type": "boolean"
        }
      }
    },

    "physicalEligibility": {
      "type": "object"
    },

    "experience": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },

    "stateId": {
      "$ref": "shared.schema.json#/$defs/id"
    },

    "governmentPreferences": {
      "$ref": "shared.schema.json#/$defs/stringArray"
    },

    "careerInterests": {
      "$ref": "shared.schema.json#/$defs/stringArray"
    },

    "preferences": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "salaryImportance",
        "authorityImportance",
        "familyImportance",
        "parentCareImportance",
        "locationImportance",
        "jobSecurityImportance",
        "lowStressImportance",
        "lowPhysicalRiskImportance",
        "careerGrowthImportance",
        "prestigeImportance",
        "workLifeImportance",
        "housingImportance"
      ],
      "properties": {
        "salaryImportance": {
          "$ref": "shared.schema.json#/$defs/score"
        },
        "authorityImportance": {
          "$ref": "shared.schema.json#/$defs/score"
        },
        "familyImportance": {
          "$ref": "shared.schema.json#/$defs/score"
        },
        "parentCareImportance": {
          "$ref": "shared.schema.json#/$defs/score"
        },
        "locationImportance": {
          "$ref": "shared.schema.json#/$defs/score"
        },
        "jobSecurityImportance": {
          "$ref": "shared.schema.json#/$defs/score"
        },
        "lowStressImportance": {
          "$ref": "shared.schema.json#/$defs/score"
        },
        "lowPhysicalRiskImportance": {
          "$ref": "shared.schema.json#/$defs/score"
        },
        "careerGrowthImportance": {
          "$ref": "shared.schema.json#/$defs/score"
        },
        "prestigeImportance": {
          "$ref": "shared.schema.json#/$defs/score"
        },
        "workLifeImportance": {
          "$ref": "shared.schema.json#/$defs/score"
        },
        "housingImportance": {
          "$ref": "shared.schema.json#/$defs/score"
        },
        "lowTransferImportance": {
          "$ref": "shared.schema.json#/$defs/score"
        },
        "lowNightDutyImportance": {
          "$ref": "shared.schema.json#/$defs/score"
        },
        "lowHolidayDutyImportance": {
          "$ref": "shared.schema.json#/$defs/score"
        },
        "lowEmergencyDutyImportance": {
          "$ref": "shared.schema.json#/$defs/score"
        }
      }
    }
  }
}
