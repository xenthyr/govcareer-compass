{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "assessment-option.schema.json",
  "title": "GovCareer Compass Assessment Option Catalogue",
  "description": "Schema for the complete reusable Career Finder option-set catalogue.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "lastUpdated",
    "optionSets"
  ],
  "properties": {
    "version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "lastUpdated": {
      "type": "string",
      "format": "date"
    },
    "schema": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "optionSets": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/optionSet"
      }
    }
  },
  "$defs": {
    "localizedText": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "en"
      ],
      "properties": {
        "en": {
          "type": "string",
          "minLength": 1
        },
        "bn": {
          "type": "string"
        }
      }
    },
    "optionSet": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "label",
        "options"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9_-]*$"
        },
        "label": {
          "$ref": "#/$defs/localizedText"
        },
        "source": {
          "type": "string"
        },
        "options": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/option"
          }
        }
      }
    },
    "option": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "label",
        "value"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_-]*$"
        },
        "label": {
          "$ref": "#/$defs/localizedText"
        },
        "value": {}
      }
    }
  }
}
