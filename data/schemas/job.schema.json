{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "job.schema.json",
  "title": "GovCareer Compass Government Job",
  "description": "Canonical government post/career record used by search, eligibility, comparison and recommendation systems.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "identity",
    "recruitment",
    "eligibility",
    "pay",
    "lifestyle",
    "location",
    "housing",
    "promotion",
    "benefits",
    "analysis",
    "sourceIds",
    "confidence",
    "currentness",
    "lastVerified",
    "dataVersion"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]*$"
    },

    "identity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "governmentId",
        "departmentId",
        "organisationId",
        "post"
      ],
      "properties": {
        "governmentId": {
          "type": "string",
          "minLength": 1
        },
        "stateId": {
          "type": "string"
        },
        "departmentId": {
          "type": "string",
          "minLength": 1
        },
        "organisationId": {
          "type": "string",
          "minLength": 1
        },
        "serviceCadreId": {
          "type": "string"
        },
        "post": {
          "$ref": "shared-localized-name.schema.json"
        },
        "abbreviation": {
          "type": "string"
        },
        "roleType": {
          "type": "string",
          "enum": [
            "ADMINISTRATIVE",
            "EXECUTIVE",
            "POLICE",
            "INVESTIGATION",
            "INTELLIGENCE",
            "ENFORCEMENT",
            "REVENUE",
            "TAX",
            "AUDIT",
            "ACCOUNTS",
            "CLERICAL",
            "RAILWAY_OPERATIONS",
            "SECURITY",
            "PANCHAYAT_ADMINISTRATION",
            "CORRECTIONS",
            "WELFARE",
            "DISASTER_MANAGEMENT",
            "POSTAL",
            "SECRETARIAT",
            "FIELD_DEVELOPMENT",
            "EDUCATION_NON_TEACHING",
            "SUPPORT",
            "OTHER"
          ]
        },
        "description": {
          "type": "string"
        }
      }
    },

    "recruitment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "routeIds",
        "mode",
        "careerStatus"
      ],
      "properties": {
        "routeIds": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "mode": {
          "type": "string",
          "enum": [
            "DIRECT_RECRUITMENT",
            "PROMOTION",
            "DEPUTATION",
            "TRANSFER",
            "CONTRACT",
            "TEMPORARY",
            "SCHEME_PROJECT",
            "OUTSOURCED",
            "OTHER"
          ]
        },
        "careerStatus": {
          "type": "string",
          "enum": [
            "ACTIVE_CAREER",
            "HISTORICAL",
            "ABOLISHED",
            "REPLACED",
            "NOT_VERIFIED"
          ]
        },
        "freshEntryEligible": {
          "type": "boolean"
        }
      }
    },

    "eligibility": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "educationLevel",
        "classification",
        "minimumQualification",
        "overqualification"
      ],
      "properties": {
        "educationLevel": {
          "type": "string",
          "enum": [
            "CLASS_8",
            "CLASS_10",
            "CLASS_12",
            "DIPLOMA",
            "GRADUATE",
            "POSTGRADUATE",
            "PROFESSIONAL",
            "OTHER"
          ]
        },
        "classification": {
          "type": "string",
          "enum": [
            "A_DIRECTLY_ELIGIBLE",
            "B_CONDITIONALLY_ELIGIBLE",
            "C_NOT_ELIGIBLE"
          ]
        },
        "minimumQualification": {
          "type": "string",
          "minLength": 1
        },
        "requiredDegrees": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "requiredSubjects": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "minimumMarks": {
          "type": "object",
          "additionalProperties": true
        },
        "conditions": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "age": {
          "type": "object",
          "additionalProperties": true
        },
        "reservation": {
          "type": "object",
          "additionalProperties": true
        },
        "domicile": {
          "type": "object",
          "additionalProperties": true
        },
        "language": {
          "type": "object",
          "additionalProperties": true
        },
        "typing": {
          "type": "object",
          "additionalProperties": true
        },
        "computer": {
          "type": "object",
          "additionalProperties": true
        },
        "experience": {
          "type": "object",
          "additionalProperties": true
        },
        "drivingLicence": {
          "type": "object",
          "additionalProperties": true
        },
        "physicalMedical": {
          "type": "object",
          "additionalProperties": true
        },
        "overqualification": {
          "type": "string",
          "enum": [
            "HIGHER_QUALIFICATION_ALLOWED",
            "HIGHER_QUALIFICATION_NOT_ADDRESSED",
            "HIGHER_QUALIFICATION_RESTRICTED",
            "EXACT_QUALIFICATION_REQUIRED",
            "CURRENT_NOTIFICATION_REQUIRED",
            "NOT_APPLICABLE"
          ]
        },
        "baEnglishAssessment": {
          "type": "string",
          "enum": [
            "DIRECT",
            "CONDITIONAL",
            "NOT_ELIGIBLE",
            "NOT_APPLICABLE",
            "CURRENT_NOTIFICATION_REQUIRED",
            "NOT_VERIFIED"
          ]
        }
      }
    },

    "pay": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "payProfileId"
      ],
      "properties": {
        "payProfileId": {
          "type": "string",
          "minLength": 1
        },
        "paySystem": {
          "type": "string"
        },
        "level": {
          "type": "string"
        },
        "startingBasic": {
          "type": "number",
          "minimum": 0
        },
        "maximumBasic": {
          "type": "number",
          "minimum": 0
        }
      }
    },

    "lifestyle": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "deskField": {
          "type": "string",
          "enum": [
            "MOSTLY_OFFICE",
            "OFFICE_PLUS_FIELD",
            "MOSTLY_FIELD",
            "OPERATIONAL",
            "MIXED",
            "NOT_VERIFIED"
          ]
        },
        "publicInteractionScore": {
          "type": "number",
          "minimum": 0,
          "maximum": 10
        },
        "computerWorkScore": {
          "type": "number",
          "minimum": 0,
          "maximum": 10
        },
        "legalWorkScore": {
          "type": "number",
          "minimum": 0,
          "maximum": 10
        },
        "accountsWorkScore": {
          "type": "number",
          "minimum": 0,
          "maximum": 10
        },
        "investigationScore": {
          "type": "number",
          "minimum": 0,
          "maximum": 10
        },
        "inspectionScore": {
          "type": "number",
          "minimum": 0,
          "maximum": 10
        },
        "supervisionScore": {
          "type": "number",
          "minimum": 0,
          "maximum": 10
        },
        "workLifeScore": {
          "type": "number",
          "minimum": 0,
          "maximum": 10
        },
        "predictabilityScore": {
          "type": "number",
          "minimum": 0,
          "maximum": 10
        },
        "stressBurden": {
          "type": "number",
          "minimum": 0,
          "maximum": 10
        },
        "riskBurden": {
          "type": "number",
          "minimum": 0,
          "maximum": 10
        },
        "nightDutyBurden": {
          "type": "number",
          "minimum": 0,
          "maximum": 10
        },
        "shiftDutyBurden": {
          "type": "number",
          "minimum": 0,
          "maximum": 10
        },
        "holidayDutyBurden": {
          "type": "number",
          "minimum": 0,
          "maximum": 10
        },
        "emergencyDutyBurden": {
          "type": "number",
          "minimum": 0,
          "maximum": 10
        },
        "travelBurden": {
          "type": "number",
          "minimum": 0,
          "maximum": 10
        },
        "courtDutyBurden": {
          "type": "number",
          "minimum": 0,
          "maximum": 10
        }
      }
    },

    "location": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "locationProfileId"
      ],
      "properties": {
        "locationProfileId": {
          "type": "string",
          "minLength": 1
        },
        "postingCategory": {
          "type": "string",
          "enum": [
            "KOLKATA_CENTRIC",
            "WEST_BENGAL_WIDE",
            "DISTRICT_BASED",
            "RURAL_HEAVY",
            "ALL_INDIA",
            "DELHI_HEAVY",
            "REMOTE",
            "LOCATION_UNCERTAIN",
            "NOT_VERIFIED"
          ]
        },
        "kolkataStability": {
          "type": "number",
          "minimum": 0,
          "maximum": 10
        },
        "geographicStability": {
          "type": "number",
          "minimum": 0,
          "maximum": 10
        },
        "ruralBurden": {
          "type": "number",
          "minimum": 0,
          "maximum": 10
        },
        "remoteBurden": {
          "type": "number",
          "minimum": 0,
          "maximum": 10
        },
        "transferBurden": {
          "type": "number",
          "minimum": 0,
          "maximum": 10
        }
      }
    },

    "housing": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "housingProfileId"
      ],
      "properties": {
        "housingProfileId": {
          "type": "string",
          "minLength": 1
        },
        "availabilityStatus": {
          "type": "string",
          "enum": [
            "MEANINGFUL_ADVANTAGE",
            "VACANCY_DEPENDENT",
            "DEPARTMENTAL",
            "LIMITED",
            "NONE_IDENTIFIED",
            "NOT_VERIFIED"
          ]
        }
      }
    },

    "promotion": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "promotionProfileId"
      ],
      "properties": {
        "promotionProfileId": {
          "type": "string",
          "minLength": 1
        }
      }
    },

    "benefits": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "benefitProfileId"
      ],
      "properties": {
        "benefitProfileId": {
          "type": "string",
          "minLength": 1
        }
      }
    },

    "analysis": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "familyCompatibilityBase": {
          "type": "number",
          "minimum": 0,
          "maximum": 10
        },
        "parentCareCompatibilityBase": {
          "type": "number",
          "minimum": 0,
          "maximum": 10
        },
        "authority": {
          "type": "number",
          "minimum": 0,
          "maximum": 10
        },
        "socialStatus": {
          "type": "number",
          "minimum": 0,
          "maximum": 10
        },
        "careerGrowth": {
          "type": "number",
          "minimum": 0,
          "maximum": 10
        },
        "safety": {
          "type": "number",
          "minimum": 0,
          "maximum": 10
        },
        "housingAdvantage": {
          "type": "number",
          "minimum": 0,
          "maximum": 10
        },
        "englishAdvantage": {
          "type": "string",
          "enum": [
            "STRONG",
            "MODERATE",
            "NEUTRAL",
            "MINOR_DISADVANTAGE",
            "NOT_ELIGIBLE",
            "NOT_APPLICABLE",
            "NOT_VERIFIED"
          ]
        },
        "advantages": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "disadvantages": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "notes": {
          "type": "string"
        }
      }
    },

    "sourceIds": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },

    "confidence": {
      "type": "string",
      "enum": [
        "HIGH",
        "MEDIUM_HIGH",
        "MEDIUM",
        "LOW",
        "ESTIMATE",
        "NOT_VERIFIED"
      ]
    },

    "currentness": {
      "type": "string",
      "enum": [
        "CURRENT",
        "HISTORICAL",
        "CURRENT_WITH_HISTORICAL_SUPPORT",
        "REPLACED",
        "ABOLISHED",
        "NOT_VERIFIED"
      ]
    },

    "lastVerified": {
      "type": "string",
      "format": "date"
    },

    "dataVersion": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    }
  }
  }
