{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "job.schema.json",
  "title": "GovCareer Compass Government Job",
  "description": "Canonical government post/career record.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "identity",
    "recruitment",
    "eligibility",
    "payProfileId",
    "locationProfileId",
    "housingProfileId",
    "promotionProfileId",
    "benefitProfileId",
    "lifestyle",
    "analysis",
    "sourceIds",
    "confidence",
    "currentness",
    "lastVerified",
    "dataVersion"
  ],
  "properties": {
    "id": {
      "$ref": "shared.schema.json#/$defs/id"
    },

    "identity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "governmentId",
        "departmentId",
        "organisationId",
        "post"
      ],
      "properties": {
        "governmentId": {
          "$ref": "shared.schema.json#/$defs/id"
        },
        "stateId": {
          "$ref": "shared.schema.json#/$defs/id"
        },
        "departmentId": {
          "$ref": "shared.schema.json#/$defs/id"
        },
        "organisationId": {
          "$ref": "shared.schema.json#/$defs/id"
        },
        "serviceCadreId": {
          "$ref": "shared.schema.json#/$defs/id"
        },
        "post": {
          "$ref": "shared.schema.json#/$defs/localizedText"
        },
        "abbreviation": {
          "type": "string"
        },
        "roleType": {
          "type": "string"
        },
        "description": {
          "$ref": "shared.schema.json#/$defs/localizedText"
        }
      }
    },

    "recruitment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "routeIds",
        "mode",
        "careerStatus",
        "freshEntryEligible"
      ],
      "properties": {
        "routeIds": {
          "$ref": "shared.schema.json#/$defs/stringArray"
        },
        "mode": {
          "type": "string",
          "enum": [
            "DIRECT_RECRUITMENT",
            "PROMOTION",
            "DEPUTATION",
            "TRANSFER",
            "CONTRACT",
            "TEMPORARY",
            "SCHEME_PROJECT",
            "OUTSOURCED",
            "OTHER"
          ]
        },
        "careerStatus": {
          "type": "string",
          "enum": [
            "ACTIVE_CAREER",
            "HISTORICAL",
            "ABOLISHED",
            "REPLACED",
            "NOT_VERIFIED"
          ]
        },
        "freshEntryEligible": {
          "type": "boolean"
        }
      }
    },

    "eligibility": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "educationLevel",
        "minimumQualification",
        "ruleIds",
        "baEnglishAssessment"
      ],
      "properties": {
        "educationLevel": {
          "type": "string",
          "enum": [
            "CLASS_8",
            "CLASS_10",
            "CLASS_12",
            "DIPLOMA",
            "ITI",
            "GRADUATE",
            "POSTGRADUATE",
            "DOCTORATE",
            "PROFESSIONAL",
            "OTHER"
          ]
        },
        "minimumQualification": {
          "type": "string"
        },
        "ruleIds": {
          "$ref": "shared.schema.json#/$defs/stringArray"
        },
        "baEnglishAssessment": {
          "type": "string",
          "enum": [
            "DIRECT",
            "CONDITIONAL",
            "NOT_ELIGIBLE",
            "CURRENT_NOTIFICATION_REQUIRED",
            "NOT_VERIFIED",
            "NOT_APPLICABLE"
          ]
        },
        "overqualification": {
          "type": "string",
          "enum": [
            "HIGHER_QUALIFICATION_ALLOWED",
            "HIGHER_QUALIFICATION_NOT_ADDRESSED",
            "HIGHER_QUALIFICATION_RESTRICTED",
            "EXACT_QUALIFICATION_REQUIRED",
            "CURRENT_NOTIFICATION_REQUIRED",
            "NOT_APPLICABLE"
          ]
        },
        "notes": {
          "type": "string"
        }
      }
    },

    "payProfileId": {
      "$ref": "shared.schema.json#/$defs/id"
    },

    "locationProfileId": {
      "$ref": "shared.schema.json#/$defs/id"
    },

    "housingProfileId": {
      "$ref": "shared.schema.json#/$defs/id"
    },

    "promotionProfileId": {
      "$ref": "shared.schema.json#/$defs/id"
    },

    "benefitProfileId": {
      "$ref": "shared.schema.json#/$defs/id"
    },

    "lifestyle": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "deskField": {
          "type": "string",
          "enum": [
            "MOSTLY_OFFICE",
            "OFFICE_PLUS_FIELD",
            "MOSTLY_FIELD",
            "OPERATIONAL",
            "MIXED",
            "NOT_VERIFIED"
          ]
        },
        "publicInteractionScore": {
          "$ref": "shared.schema.json#/$defs/score"
        },
        "computerWorkScore": {
          "$ref": "shared.schema.json#/$defs/score"
        },
        "legalWorkScore": {
          "$ref": "shared.schema.json#/$defs/score"
        },
        "accountsWorkScore": {
          "$ref": "shared.schema.json#/$defs/score"
        },
        "investigationScore": {
          "$ref": "shared.schema.json#/$defs/score"
        },
        "inspectionScore": {
          "$ref": "shared.schema.json#/$defs/score"
        },
        "supervisionScore": {
          "$ref": "shared.schema.json#/$defs/score"
        },
        "workLifeScore": {
          "$ref": "shared.schema.json#/$defs/score"
        },
        "predictabilityScore": {
          "$ref": "shared.schema.json#/$defs/score"
        },
        "stressBurden": {
          "$ref": "shared.schema.json#/$defs/score"
        },
        "riskBurden": {
          "$ref": "shared.schema.json#/$defs/score"
        },
        "nightDutyBurden": {
          "$ref": "shared.schema.json#/$defs/score"
        },
        "shiftDutyBurden": {
          "$ref": "shared.schema.json#/$defs/score"
        },
        "holidayDutyBurden": {
          "$ref": "shared.schema.json#/$defs/score"
        },
        "emergencyDutyBurden": {
          "$ref": "shared.schema.json#/$defs/score"
        },
        "travelBurden": {
          "$ref": "shared.schema.json#/$defs/score"
        },
        "courtDutyBurden": {
          "$ref": "shared.schema.json#/$defs/score"
        }
      }
    },

    "analysis": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "familyCompatibilityBase": {
          "$ref": "shared.schema.json#/$defs/score"
        },
        "parentCareCompatibilityBase": {
          "$ref": "shared.schema.json#/$defs/score"
        },
        "authority": {
          "$ref": "shared.schema.json#/$defs/score"
        },
        "socialStatus": {
          "$ref": "shared.schema.json#/$defs/score"
        },
        "careerGrowth": {
          "$ref": "shared.schema.json#/$defs/score"
        },
        "safety": {
          "$ref": "shared.schema.json#/$defs/score"
        },
        "housingAdvantage": {
          "$ref": "shared.schema.json#/$defs/score"
        },
        "englishAdvantage": {
          "type": "string",
          "enum": [
            "STRONG",
            "MODERATE",
            "NEUTRAL",
            "MINOR_DISADVANTAGE",
            "NOT_ELIGIBLE",
            "NOT_APPLICABLE",
            "NOT_VERIFIED"
          ]
        }
      }
    },

    "sourceIds": {
      "$ref": "shared.schema.json#/$defs/stringArray"
    },

    "confidence": {
      "$ref": "shared.schema.json#/$defs/confidence"
    },

    "currentness": {
      "$ref": "shared.schema.json#/$defs/currentness"
    },

    "lastVerified": {
      "$ref": "shared.schema.json#/$defs/date"
    },

    "dataVersion": {
      "$ref": "shared.schema.json#/$defs/version"
    }
  }
}
