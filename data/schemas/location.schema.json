{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "location.schema.json",
  "title": "GovCareer Compass Location Profile",
  "description": "Posting, geographic and transfer profile.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "postingCategory",
    "confidence",
    "lastVerified",
    "dataVersion"
  ],
  "properties": {
    "id": {
      "$ref": "shared.schema.json#/$defs/id"
    },
    "postingCategory": {
      "type": "string",
      "enum": [
        "KOLKATA_CENTRIC",
        "WEST_BENGAL_WIDE",
        "DISTRICT_BASED",
        "RURAL_HEAVY",
        "URBAN_HEAVY",
        "ALL_INDIA",
        "DELHI_HEAVY",
        "REMOTE",
        "LOCATION_UNCERTAIN",
        "NOT_VERIFIED"
      ]
    },
    "stateIds": {
      "$ref": "shared.schema.json#/$defs/stringArray"
    },
    "districts": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "cities": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "headquartersLocations": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "kolkataStability": {
      "$ref": "shared.schema.json#/$defs/score"
    },
    "geographicStability": {
      "$ref": "shared.schema.json#/$defs/score"
    },
    "ruralBurden": {
      "$ref": "shared.schema.json#/$defs/score"
    },
    "remoteBurden": {
      "$ref": "shared.schema.json#/$defs/score"
    },
    "transferBurden": {
      "$ref": "shared.schema.json#/$defs/score"
    },
    "requestTransfer": {
      "type": "object"
    },
    "promotionTransferRisk": {
      "type": "string"
    },
    "notes": {
      "type": "string"
    },
    "sourceIds": {
      "$ref": "shared.schema.json#/$defs/stringArray"
    },
    "confidence": {
      "$ref": "shared.schema.json#/$defs/confidence"
    },
    "lastVerified": {
      "$ref": "shared.schema.json#/$defs/date"
    },
    "dataVersion": {
      "$ref": "shared.schema.json#/$defs/version"
    }
  }
}
