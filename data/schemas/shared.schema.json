{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://govcareer-compass.example/schema/shared.schema.json",
  "title": "GovCareer Compass Shared Schema Definitions",
  "description": "Shared reusable definitions used throughout the GovCareer Compass canonical data schemas.",
  "type": "object",
  "$defs": {
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
      "description": "Stable language-independent canonical identifier."
    },

    "version": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$",
      "description": "Semantic-style schema or record version."
    },

    "localizedText": {
      "type": "object",
      "description": "Localized user-facing text keyed by BCP-47-style language code.",
      "minProperties": 1,
      "additionalProperties": {
        "type": "string"
      },
      "properties": {
        "en": {
          "type": "string"
        },
        "bn": {
          "type": "string"
        }
      }
    },

    "localizedTextRequiredEnglish": {
      "type": "object",
      "description": "Localized text requiring an English canonical value while allowing future languages.",
      "required": [
        "en"
      ],
      "additionalProperties": {
        "type": "string"
      },
      "properties": {
        "en": {
          "type": "string",
          "minLength": 1
        },
        "bn": {
          "type": "string"
        },
        "hi": {
          "type": "string"
        },
        "mr": {
          "type": "string"
        },
        "ta": {
          "type": "string"
        },
        "te": {
          "type": "string"
        },
        "gu": {
          "type": "string"
        },
        "or": {
          "type": "string"
        },
        "as": {
          "type": "string"
        }
      }
    },

    "nonEmptyString": {
      "type": "string",
      "minLength": 1
    },

    "positiveInteger": {
      "type": "integer",
      "minimum": 1
    },

    "nonNegativeInteger": {
      "type": "integer",
      "minimum": 0
    },

    "score10": {
      "type": "number",
      "minimum": 0,
      "maximum": 10
    },

    "percentage": {
      "type": "number",
      "minimum": 0,
      "maximum": 100
    },

    "date": {
      "type": "string",
      "format": "date"
    },

    "dateTime": {
      "type": "string",
      "format": "date-time"
    },

    "idArray": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/id"
      },
      "uniqueItems": true
    },

    "nonEmptyStringArray": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/nonEmptyString"
      },
      "uniqueItems": true
    },

    "sourceReference": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sourceId"
      ],
      "properties": {
        "sourceId": {
          "$ref": "#/$defs/id"
        },
        "claim": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "note": {
          "$ref": "#/$defs/nonEmptyString"
        }
      }
    },

    "sourceReferenceArray": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/sourceReference"
      },
      "uniqueItems": true
    },

    "hardSoftClassification": {
      "type": "string",
      "enum": [
        "HARD",
        "SOFT"
      ]
    },

    "confidence": {
      "type": "string",
      "enum": [
        "HIGH",
        "MEDIUM_HIGH",
        "MEDIUM",
        "LOW",
        "ESTIMATE",
        "NOT_VERIFIED"
      ]
    },

    "dataStatus": {
      "type": "string",
      "enum": [
        "ACTIVE",
        "CURRENT_NO_RECRUITMENT",
        "HISTORICAL",
        "RENAMED",
        "MERGED",
        "REORGANISED",
        "REPLACED",
        "ABOLISHED",
        "TEMPORARY",
        "UNKNOWN"
      ]
    },

    "languageCode": {
      "type": "string",
      "pattern": "^[A-Za-z]{2,3}(?:-[A-Za-z0-9]{2,8})*$"
    }
  }
}
