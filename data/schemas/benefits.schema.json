{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "benefits.schema.json",
  "title": "GovCareer Compass Benefits Profile",
  "description": "Retirement, leave, medical and employee-benefit profile associated with a career.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "retirement",
    "confidence",
    "lastVerified",
    "dataVersion"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]*$"
    },
    "retirement": {
      "type": "object",
      "additionalProperties": true
    },
    "pensionFramework": {
      "type": "string"
    },
    "nps": {
      "type": "object",
      "additionalProperties": true
    },
    "gratuity": {
      "type": "object",
      "additionalProperties": true
    },
    "familyBenefits": {
      "type": "object",
      "additionalProperties": true
    },
    "leave": {
      "type": "object",
      "additionalProperties": true
    },
    "medical": {
      "type": "object",
      "additionalProperties": true
    },
    "insurance": {
      "type": "object",
      "additionalProperties": true
    },
    "employeeWelfare": {
      "type": "object",
      "additionalProperties": true
    },
    "travelBenefits": {
      "type": "object",
      "additionalProperties": true
    },
    "accommodationBenefits": {
      "type": "object",
      "additionalProperties": true
    },
    "appointmentDateConditions": {
      "type": "string"
    },
    "sourceIds": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "confidence": {
      "type": "string",
      "enum": [
        "HIGH",
        "MEDIUM_HIGH",
        "MEDIUM",
        "LOW",
        "ESTIMATE",
        "NOT_VERIFIED"
      ]
    },
    "lastVerified": {
      "type": "string",
      "format": "date"
    },
    "dataVersion": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    }
  }
}
