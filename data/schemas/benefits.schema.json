{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "benefits.schema.json",
  "title": "GovCareer Compass Benefits Profile",
  "description": "Retirement, pension, leave, medical and employee-benefit profile.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "confidence",
    "lastVerified",
    "dataVersion"
  ],
  "properties": {
    "id": {
      "$ref": "shared.schema.json#/$defs/id"
    },
    "retirementAge": {
      "type": "number",
      "minimum": 0
    },
    "retirementFramework": {
      "type": "string"
    },
    "pensionFramework": {
      "type": "string"
    },
    "nps": {
      "type": "object"
    },
    "gratuity": {
      "type": "object"
    },
    "familyBenefits": {
      "type": "object"
    },
    "leave": {
      "type": "object"
    },
    "medical": {
      "type": "object"
    },
    "insurance": {
      "type": "object"
    },
    "employeeWelfare": {
      "type": "object"
    },
    "travelBenefits": {
      "type": "object"
    },
    "accommodationBenefits": {
      "type": "object"
    },
    "appointmentDateConditions": {
      "type": "string"
    },
    "sourceIds": {
      "$ref": "shared.schema.json#/$defs/stringArray"
    },
    "confidence": {
      "$ref": "shared.schema.json#/$defs/confidence"
    },
    "lastVerified": {
      "$ref": "shared.schema.json#/$defs/date"
    },
    "dataVersion": {
      "$ref": "shared.schema.json#/$defs/version"
    }
  }
}
