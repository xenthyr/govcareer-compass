{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "common-reference.schema.json",
  "title": "GovCareer Compass Common Reference Record",
  "description": "Reusable reference record with stable ID and localized label.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "label"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]*$"
    },
    "label": {
      "$ref": "shared-localized-name.schema.json"
    },
    "description": {
      "$ref": "shared-localized-name.schema.json"
    },
    "status": {
      "type": "string"
    },
    "sourceIds": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    }
  }
}
