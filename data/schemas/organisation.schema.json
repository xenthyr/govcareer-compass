{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "organisation.schema.json",
  "title": "GovCareer Compass Organisation",
  "description": "Government commission, board, force, authority, directorate, attached office or other organisation.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "governmentId",
    "name",
    "type",
    "status",
    "confidence",
    "lastVerified",
    "dataVersion"
  ],
  "properties": {
    "id": {
      "$ref": "shared.schema.json#/$defs/id"
    },
    "governmentId": {
      "$ref": "shared.schema.json#/$defs/id"
    },
    "stateId": {
      "$ref": "shared.schema.json#/$defs/id"
    },
    "departmentId": {
      "$ref": "shared.schema.json#/$defs/id"
    },
    "name": {
      "$ref": "shared.schema.json#/$defs/localizedText"
    },
    "shortName": {
      "type": "string"
    },
    "type": {
      "type": "string",
      "enum": [
        "COMMISSION",
        "BOARD",
        "DIRECTORATE",
        "POLICE_ORGANISATION",
        "POLICE_FORCE",
        "CENTRAL_ARMED_FORCE",
        "RAILWAY_ORGANISATION",
        "AUTHORITY",
        "ATTACHED_OFFICE",
        "SUBORDINATE_OFFICE",
        "STATUTORY_BODY",
        "AUTONOMOUS_BODY",
        "PUBLIC_BODY",
        "OTHER"
      ]
    },
    "description": {
      "$ref": "shared.schema.json#/$defs/localizedText"
    },
    "website": {
      "$ref": "shared.schema.json#/$defs/url"
    },
    "sourceIds": {
      "$ref": "shared.schema.json#/$defs/stringArray"
    },
    "status": {
      "type": "string",
      "enum": [
        "ACTIVE",
        "HISTORICAL",
        "REPLACED",
        "ABOLISHED",
        "NOT_VERIFIED"
      ]
    },
    "confidence": {
      "$ref": "shared.schema.json#/$defs/confidence"
    },
    "lastVerified": {
      "$ref": "shared.schema.json#/$defs/date"
    },
    "dataVersion": {
      "$ref": "shared.schema.json#/$defs/version"
    }
  }
}
