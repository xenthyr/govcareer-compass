{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "exam.schema.json",
  "title": "GovCareer Compass Examination",
  "description": "Government recruitment examination or selection route.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "name",
    "governmentId",
    "authorityId",
    "stages",
    "status",
    "confidence",
    "sourceIds",
    "lastVerified",
    "dataVersion"
  ],
  "properties": {
    "id": {
      "$ref": "shared.schema.json#/$defs/id"
    },
    "name": {
      "$ref": "shared.schema.json#/$defs/localizedText"
    },
    "fullName": {
      "type": "string"
    },
    "abbreviation": {
      "type": "string"
    },
    "governmentId": {
      "$ref": "shared.schema.json#/$defs/id"
    },
    "stateId": {
      "$ref": "shared.schema.json#/$defs/id"
    },
    "authorityId": {
      "$ref": "shared.schema.json#/$defs/id"
    },
    "departmentIds": {
      "$ref": "shared.schema.json#/$defs/stringArray"
    },
    "organisationIds": {
      "$ref": "shared.schema.json#/$defs/stringArray"
    },
    "qualificationRuleIds": {
      "$ref": "shared.schema.json#/$defs/stringArray"
    },
    "stages": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "order",
          "type"
        ],
        "properties": {
          "order": {
            "type": "integer",
            "minimum": 1
          },
          "type": {
            "type": "string",
            "enum": [
              "PRELIMINARY",
              "MAIN",
              "DESCRIPTIVE",
              "INTERVIEW",
              "PERSONALITY_TEST",
              "PHYSICAL",
              "MEDICAL",
              "SKILL_TEST",
              "TYPING_TEST",
              "DOCUMENT_VERIFICATION",
              "OTHER"
            ]
          },
          "name": {
            "type": "string"
          },
          "mandatory": {
            "type": "boolean"
          },
          "description": {
            "type": "string"
          }
        }
      }
    },
    "skillTests": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "physicalRequirements": {
      "type": "object"
    },
    "medicalRequirements": {
      "type": "object"
    },
    "syllabus": {
      "type": "object"
    },
    "attemptRules": {
      "type": "object"
    },
    "difficulty": {
      "type": "string",
      "enum": [
        "EASY",
        "MODERATE",
        "HARD",
        "VERY_HARD",
        "EXTREME",
        "NOT_VERIFIED"
      ]
    },
    "preparationBurden": {
      "type": "string",
      "enum": [
        "LOW",
        "MODERATE",
        "HIGH",
        "VERY_HIGH",
        "EXTREME",
        "NOT_VERIFIED"
      ]
    },
    "recruitmentFrequency": {
      "type": "string",
      "enum": [
        "ANNUAL",
        "NEARLY_ANNUAL",
        "PERIODIC",
        "IRREGULAR",
        "RARE",
        "DEPARTMENT_SPECIFIC",
        "NOT_VERIFIED"
      ]
    },
    "mainPostIds": {
      "$ref": "shared.schema.json#/$defs/stringArray"
    },
    "recruitmentIds": {
      "$ref": "shared.schema.json#/$defs/stringArray"
    },
    "status": {
      "type": "string",
      "enum": [
        "ACTIVE",
        "CURRENT_RECRUITMENT",
        "RECENTLY_COMPLETED",
        "HISTORICAL",
        "DISCONTINUED",
        "NOT_VERIFIED"
      ]
    },
    "sourceIds": {
      "$ref": "shared.schema.json#/$defs/stringArray"
    },
    "confidence": {
      "$ref": "shared.schema.json#/$defs/confidence"
    },
    "lastVerified": {
      "$ref": "shared.schema.json#/$defs/date"
    },
    "dataVersion": {
      "$ref": "shared.schema.json#/$defs/version"
    }
  }
}
