{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "pay.schema.json",
  "title": "GovCareer Compass Pay Profile",
  "description": "Government pay-system and compensation profile.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "governmentId",
    "paySystem",
    "confidence",
    "lastVerified",
    "dataVersion"
  ],
  "properties": {
    "id": {
      "$ref": "shared.schema.json#/$defs/id"
    },
    "governmentId": {
      "$ref": "shared.schema.json#/$defs/id"
    },
    "stateId": {
      "$ref": "shared.schema.json#/$defs/id"
    },
    "paySystem": {
      "type": "string"
    },
    "payCommission": {
      "type": "string"
    },
    "payLevel": {
      "type": "string"
    },
    "payScale": {
      "type": "string"
    },
    "startingBasic": {
      "type": "number",
      "minimum": 0
    },
    "maximumBasic": {
      "type": "number",
      "minimum": 0
    },
    "da": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "PERCENTAGE",
            "FIXED",
            "UNKNOWN"
          ]
        },
        "value": {
          "type": "number",
          "minimum": 0
        },
        "effectiveDate": {
          "$ref": "shared.schema.json#/$defs/date"
        }
      }
    },
    "hra": {
      "type": "object"
    },
    "transportAllowance": {
      "type": "object"
    },
    "otherAllowances": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "deductions": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "grossEstimate": {
      "type": "object"
    },
    "inHandEstimate": {
      "type": "object"
    },
    "officialStatus": {
      "type": "string",
      "enum": [
        "OFFICIAL",
        "CALCULATED",
        "ESTIMATED",
        "NOT_VERIFIED"
      ]
    },
    "sourceIds": {
      "$ref": "shared.schema.json#/$defs/stringArray"
    },
    "confidence": {
      "$ref": "shared.schema.json#/$defs/confidence"
    },
    "lastVerified": {
      "$ref": "shared.schema.json#/$defs/date"
    },
    "dataVersion": {
      "$ref": "shared.schema.json#/$defs/version"
    }
  }
}
