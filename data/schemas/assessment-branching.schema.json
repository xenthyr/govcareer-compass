{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "assessment-branching.schema.json",
  "title": "GovCareer Compass Assessment Branching",
  "description": "Schema for conditional Career Finder presentation rules.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "lastUpdated",
    "assessmentId",
    "defaultStartQuestionId",
    "rules"
  ],
  "properties": {
    "version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "lastUpdated": {
      "type": "string",
      "format": "date"
    },
    "schema": {
      "type": "string"
    },
    "assessmentId": {
      "type": "string",
      "minLength": 1
    },
    "defaultStartQuestionId": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string"
    },
    "rules": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/rule"
      }
    }
  },
  "$defs": {
    "condition": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "operator"
      ],
      "properties": {
        "operator": {
          "type": "string",
          "enum": [
            "ALWAYS",
            "EQUALS",
            "NOT_EQUALS",
            "IN",
            "NOT_IN",
            "CONTAINS",
            "NOT_CONTAINS",
            "INCLUDES_ANY",
            "NOT_INCLUDES_ANY",
            "GREATER_THAN",
            "GREATER_THAN_OR_EQUAL",
            "LESS_THAN",
            "LESS_THAN_OR_EQUAL"
          ]
        },
        "value": {}
      }
    },
    "rule": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "sourceQuestionId",
        "condition",
        "action",
        "targetQuestionIds",
        "priority"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9_-]*$"
        },
        "sourceQuestionId": {
          "type": "string",
          "minLength": 1
        },
        "condition": {
          "$ref": "#/$defs/condition"
        },
        "action": {
          "type": "string",
          "enum": [
            "SHOW",
            "HIDE",
            "REQUIRE",
            "OPTIONAL"
          ]
        },
        "targetQuestionIds": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "priority": {
          "type": "integer",
          "minimum": 0
        }
      }
    }
  }
}
