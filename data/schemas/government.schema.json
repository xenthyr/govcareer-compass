{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "government.schema.json",
  "title": "GovCareer Compass Government",
  "description": "Government-system record.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "name",
    "type",
    "enabled",
    "coverage",
    "dataVersion"
  ],
  "properties": {
    "id": {
      "$ref": "shared.schema.json#/$defs/id"
    },
    "name": {
      "$ref": "shared.schema.json#/$defs/localizedText"
    },
    "type": {
      "type": "string",
      "enum": [
        "CENTRAL",
        "STATE",
        "LOCAL",
        "PSU",
        "STATUTORY_BODY",
        "AUTONOMOUS_BODY",
        "OTHER"
      ]
    },
    "enabled": {
      "type": "boolean"
    },
    "coverage": {
      "type": "string",
      "enum": [
        "ACTIVE",
        "PLANNED",
        "PARTIAL",
        "DISABLED"
      ]
    },
    "description": {
      "$ref": "shared.schema.json#/$defs/localizedText"
    },
    "sourceIds": {
      "$ref": "shared.schema.json#/$defs/stringArray"
    },
    "dataVersion": {
      "$ref": "shared.schema.json#/$defs/version"
    }
  }
}
