{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://govcareer-compass.example/schema/service-cadre.schema.json",
  "title": "GovCareer Compass Service Cadre",
  "description": "Canonical schema for a government service or cadre. A service/cadre is distinct from an individual post and from a recruitment examination.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "name",
    "governmentId",
    "type",
    "status",
    "version"
  ],
  "properties": {
    "id": {
      "$ref": "shared.schema.json#/$defs/id"
    },

    "name": {
      "$ref": "shared.schema.json#/$defs/localizedTextRequiredEnglish"
    },

    "shortName": {
      "$ref": "shared.schema.json#/$defs/localizedText"
    },

    "fullForm": {
      "type": "string",
      "minLength": 1
    },

    "governmentId": {
      "$ref": "shared.schema.json#/$defs/id"
    },

    "stateId": {
      "$ref": "shared.schema.json#/$defs/id"
    },

    "ministryId": {
      "$ref": "shared.schema.json#/$defs/id"
    },

    "departmentId": {
      "$ref": "shared.schema.json#/$defs/id"
    },

    "organisationId": {
      "$ref": "shared.schema.json#/$defs/id"
    },

    "parentServiceCadreId": {
      "$ref": "shared.schema.json#/$defs/id"
    },

    "type": {
      "type": "string",
      "enum": [
        "CIVIL_SERVICE",
        "POLICE_SERVICE",
        "REVENUE_SERVICE",
        "TAX_SERVICE",
        "AUDIT_SERVICE",
        "ACCOUNTS_SERVICE",
        "ADMINISTRATIVE_SERVICE",
        "SECRETARIAT_SERVICE",
        "PANCHAYAT_SERVICE",
        "EDUCATION_SERVICE",
        "FOREST_SERVICE",
        "CORRECTIONAL_SERVICE",
        "FIRE_SERVICE",
        "POSTAL_SERVICE",
        "RAILWAY_SERVICE",
        "SECURITY_SERVICE",
        "OTHER"
      ]
    },

    "serviceGroup": {
      "type": "string",
      "enum": [
        "GROUP_A",
        "GROUP_B",
        "GROUP_C",
        "GROUP_D",
        "OTHER",
        "UNKNOWN"
      ]
    },

    "cadreControl": {
      "type": "string",
      "enum": [
        "STATE",
        "CENTRAL",
        "JOINT",
        "DEPARTMENTAL",
        "ORGANISATION_SPECIFIC",
        "UNKNOWN"
      ]
    },

    "classification": {
      "type": "string",
      "enum": [
        "STATE_GOVERNMENT_SERVICE",
        "CENTRAL_GOVERNMENT_SERVICE",
        "LOCAL_GOVERNMENT_SERVICE",
        "STATUTORY_BODY_SERVICE",
        "CORPORATION_SERVICE",
        "PSU_SERVICE",
        "AUTONOMOUS_BODY_SERVICE",
        "OTHER",
        "UNKNOWN"
      ]
    },

    "postIds": {
      "$ref": "shared.schema.json#/$defs/idArray"
    },

    "examIds": {
      "$ref": "shared.schema.json#/$defs/idArray"
    },

    "recruitmentRouteIds": {
      "$ref": "shared.schema.json#/$defs/idArray"
    },

    "eligibilityRuleIds": {
      "$ref": "shared.schema.json#/$defs/idArray"
    },

    "payIds": {
      "$ref": "shared.schema.json#/$defs/idArray"
    },

    "promotionIds": {
      "$ref": "shared.schema.json#/$defs/idArray"
    },

    "benefitIds": {
      "$ref": "shared.schema.json#/$defs/idArray"
    },

    "locationIds": {
      "$ref": "shared.schema.json#/$defs/idArray"
    },

    "sourceIds": {
      "$ref": "shared.schema.json#/$defs/idArray"
    },

    "keywords": {
      "$ref": "shared.schema.json#/$defs/nonEmptyStringArray"
    },

    "description": {
      "$ref": "shared.schema.json#/$defs/localizedText"
    },

    "status": {
      "type": "string",
      "enum": [
        "ACTIVE",
        "HISTORICAL",
        "RENAMED",
        "MERGED",
        "REORGANISED",
        "ABOLISHED",
        "UNKNOWN"
      ]
    },

    "effectiveFrom": {
      "$ref": "shared.schema.json#/$defs/date"
    },

    "effectiveTo": {
      "$ref": "shared.schema.json#/$defs/date"
    },

    "historicalNames": {
      "$ref": "shared.schema.json#/$defs/nonEmptyStringArray"
    },

    "notes": {
      "$ref": "shared.schema.json#/$defs/localizedText"
    },

    "sourceReferences": {
      "$ref": "shared.schema.json#/$defs/sourceReferenceArray"
    },

    "confidence": {
      "$ref": "shared.schema.json#/$defs/confidence"
    },

    "version": {
      "$ref": "shared.schema.json#/$defs/version"
    }
  },

  "allOf": [
    {
      "if": {
        "required": [
          "stateId"
        ]
      },
      "then": {
        "required": [
          "governmentId"
        ]
      }
    }
  ]
}
