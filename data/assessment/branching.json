      "sourceQuestionId": "highest_education",
      "condition": {
        "operator": "IN",
        "value": [
          "GRADUATE",
          "POSTGRADUATE",
          "DOCTORATE"
        ]
      },
      "action": "SHOW",
      "targetQuestionIds": [
