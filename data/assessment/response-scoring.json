{
  "version": "1.0.0",
  "lastUpdated": "2026-08-31",
  "schema": "../schemas/assessment-response-scoring.schema.json",
  "assessmentId": "career-finder",
  "description": "Transforms assessment responses into normalized candidate preference values and analytical profile indicators. It never directly assigns government jobs or overrides eligibility.",
  "principles": [
    "Eligibility is evaluated independently from preference scoring.",
    "Assessment answers influence candidate preferences, not official job eligibility.",
    "Higher burden values mean worse suitability when a burden metric is used.",
    "Unknown or undisclosed values must not automatically be treated as zero.",
    "Recommendations must show important trade-offs.",
    "Analytical scores must never be represented as official government rankings."
  ],
  "answerMappings": [
