  "derivedIndicators": [
    {
      "id": "family_first_profile",
      "when": {
        "all": [
          {
            "path": "preferences.familyImportance",
            "operator": "GREATER_THAN_OR_EQUAL",
            "value": 8
          },
          {
            "path": "preferences.parentCareImportance",
            "operator": "GREATER_THAN_OR_EQUAL",
            "value": 8
          }
        ]
      },
      "set": {
        "profileTags": [
          "FAMILY_FIRST"
        ]
      }
    },
    {
      "id": "authority_first_profile",
      "when": {
        "all": [
          {
            "path": "preferences.authorityImportance",
            "operator": "GREATER_THAN_OR_EQUAL",
            "value": 8
          },
          {
            "path": "preferences.prestigeImportance",
            "operator": "GREATER_THAN_OR_EQUAL",
            "value": 7
          }
        ]
      },
      "set": {
        "profileTags": [
          "AUTHORITY_FIRST"
        ]
      }
    },
    {
      "id": "location_sensitive_profile",
      "when": {
        "all": [
          {
            "path": "preferences.locationImportance",
            "operator": "GREATER_THAN_OR_EQUAL",
            "value": 8
          },
          {
            "path": "family.locationFlexibility",
            "operator": "LESS_THAN_OR_EQUAL",
            "value": 3
          }
        ]
      },
      "set": {
        "profileTags": [
          "LOCATION_SENSITIVE"
        ]
      }
    },
    {
      "id": "low_operational_burden_profile",
      "when": {
        "any": [
          {
            "path": "preferences.lowNightDutyImportance",
            "operator": "GREATER_THAN_OR_EQUAL",
            "value": 8
          },
          {
            "path": "preferences.lowShiftDutyImportance",
            "operator": "GREATER_THAN_OR_EQUAL",
            "value": 8
          },
          {
            "path": "preferences.lowEmergencyDutyImportance",
            "operator": "GREATER_THAN_OR_EQUAL",
            "value": 8
          }
        ]
      },
      "set": {
        "profileTags": [
          "LOW_OPERATIONAL_BURDEN"
        ]
      }
    }
  ],
  "normalization": {
    "minScore": 0,
    "maxScore": 10,
    "rounding": "HALF_UP",
    "unknownHandling": "PRESERVE_UNKNOWN"
  },
  "presentationRules": [
    {
      "id": "eligibility_separate",
      "description": "Preference scoring must never override a failed eligibility requirement."
    },
    {
      "id": "analytical_not_official",
      "description": "Assessment-derived scores are analytical and must not be presented as official government rankings."
    },
    {
      "id": "explain_major_factors",
      "description": "Recommendations should explain the strongest positive and negative factors contributing to the result."
    },
    {
      "id": "show_tradeoffs",
      "description": "The result should display important disadvantages or conflicts rather than only positive factors."
    },
    {
      "id": "preserve_unknown",
      "description": "Prefer not to say, unavailable and unanswered values must remain distinguishable from genuine negative answers."
    },
    {
      "id": "no_job_hardcoding",
      "description": "This assessment file must not hard-code specific government jobs, posts or exam recommendations."
    }
  ]
}
