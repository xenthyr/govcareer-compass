{
  "version": "1.0.0",
  "lastUpdated": "2026-08-31",
  "schema": "../schemas/assessment-profile-field.schema.json",
  "profileNamespace": "candidateProfile",
  "description": "Canonical mapping between Career Finder responses and the normalized candidate profile consumed by eligibility, preference, scoring and ranking engines.",
  "principles": [
    "Profile paths are stable API-like contracts between assessment and application logic.",
    "Changing a path requires coordinated changes in JavaScript and tests.",
    "Qualification data references the canonical common qualification catalogue.",
    "Assessment preferences are distinct from official job attributes.",
    "Unknown or undisclosed values must remain distinguishable from negative values."
  ],
