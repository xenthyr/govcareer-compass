      "id": "educationLevel",
      "path": "educationLevel",
      "type": "ENUM",
      "source": "highest_education",
      "description": {
        "en": "Highest educational level selected by the candidate.",
        "bn": "প্রার্থী নির্বাচিত সর্বোচ্চ শিক্ষাগত স্তর।"
      }
    },
