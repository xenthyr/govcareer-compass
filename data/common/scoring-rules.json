  "rules": [
    {
      "id": "ELIGIBILITY_BEFORE_SCORING",
      "type": "HARD_RULE",
      "description": "Suitability scoring must not be used to make an ineligible career appear eligible."
    },
    {
      "id": "HARD_CONSTRAINTS_BEFORE_PREFERENCES",
      "type": "HARD_RULE",
      "description": "Mandatory qualification, age, physical, medical, language, domicile and other hard conditions are evaluated before preference scoring."
    },
    {
      "id": "BURDEN_DIRECTION",
      "type": "SAFETY_RULE",
      "description": "Higher burden values represent worse suitability and must not accidentally improve ranking."
    },
    {
      "id": "UNKNOWN_IS_NOT_ZERO",
      "type": "DATA_RULE",
      "description": "Unknown or unverified information must not automatically be interpreted as zero."
    },
    {
      "id": "NO_OFFICIAL_RANKING_CLAIM",
      "type": "PRESENTATION_RULE",
      "description": "Analytical career scores must never be described as official government rankings."
    },
    {
      "id": "EXPLAIN_RECOMMENDATION",
      "type": "UX_RULE",
      "description": "A recommendation should show the major factors contributing to the result."
    },
    {
      "id": "SHOW_TRADEOFFS",
      "type": "UX_RULE",
      "description": "Recommendations should identify important disadvantages or conflicts, not only positive factors."
    }
  ]
}
