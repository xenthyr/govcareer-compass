  "scoreInterpretation": [
    {
      "min": 90,
      "max": 100,
      "label": {
        "en": "Exceptional Fit",
        "bn": "অসাধারণ সামঞ্জস্য"
      }
    },
    {
      "min": 80,
      "max": 89.99,
      "label": {
        "en": "Strong Fit",
        "bn": "খুব ভালো সামঞ্জস্য"
      }
    },
